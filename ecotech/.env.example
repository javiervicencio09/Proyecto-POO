# ==============================================================================
# CONFIGURACIÓN DEL SISTEMA ECOTECH SOLUTIONS (TI3021 - UNIDAD 3)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MOTOR DE BASE DE DATOS (PERSISTENCIA LOCAL)
# ------------------------------------------------------------------------------
# Opciones disponibles: "sqlite" o "mysql"
DB_ENGINE=sqlite

# Parámetros para SQLite local:
DB_NAME=ecotech.db
DB_SQLITE_FALLBACK=ecotech.db

# Parámetros para MySQL (WampServer / XAMPP):
# DB_ENGINE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=ecotech

# ------------------------------------------------------------------------------
# 2. SERVICIOS EXTERNOS: API DE CLIMA (PLANIFICACIÓN DE PROYECTOS SOSTENIBLES)
# ------------------------------------------------------------------------------
# Proveedores soportados: "open-meteo" (gratuito sin key obligatoria) o "openweathermap"
WEATHER_API_PROVIDER=open-meteo
WEATHER_API_KEY=tu_api_key_aqui
WEATHER_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
WEATHER_FORECAST_URL=https://api.open-meteo.com/v1/forecast

# ------------------------------------------------------------------------------
# 3. SERVICIOS EXTERNOS: API DE DIVISAS (PAGOS INTERNACIONALES)
# ------------------------------------------------------------------------------
# Proveedores soportados: "mindicador" (Banco Central / Indicadores Chile) o "open-er"
EXCHANGE_API_PROVIDER=mindicador
EXCHANGE_API_KEY=tu_api_key_aqui
EXCHANGE_API_URL=https://mindicador.cl/api
EXCHANGE_FALLBACK_URL=https://open.er-api.com/v6/latest/CLP

# ------------------------------------------------------------------------------
# 4. PARÁMETROS DE SEGURIDAD Y CONTROL DE RED (CRITERIOS 3.1.2 Y 3.1.3)
# ------------------------------------------------------------------------------
# Tiempo límite en segundos para llamadas HTTP a APIs externas (previene congelamiento)
API_TIMEOUT=5.0

# Número máximo de intentos fallidos antes de bloquear autenticación
MAX_LOGIN_INTENTOS=3
